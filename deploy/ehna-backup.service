# نسخة احتياطية ليلية. مع ehna-backup.timer:
#
#   sudo systemctl enable --now ehna-backup.timer
#
[Unit]
Description=نسخة احتياطية لمساحة إحنا

[Service]
Type=oneshot
User=ehna
WorkingDirectory=/opt/gonaim-os
EnvironmentFile=/opt/gonaim-os/.env
Environment=EHNA_DIR=/var/lib/ehna
ExecStart=/usr/bin/npm run ehna:backup
