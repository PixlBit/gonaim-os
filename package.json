{
  "name": "gonaim-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gonaim/web",
    "build": "npm run build -w @gonaim/web",
    "test": "vitest run",
    "typecheck": "tsc -b --force && tsc -p apps/api && tsc -p apps/ehna-api && tsc -p apps/ehna",
    "dev:api": "npm run dev -w @gonaim/api",
    "scan": "node scripts/scan-bundle.mjs",
    "ci": "npm run typecheck && npx vitest run && npm run build && npm run ehna:build && npm run scan",
    "migrate": "tsx scripts/migrate.mts",
    "cycle": "tsx scripts/cycle.mts",
    "setup": "tsx scripts/setup.mts",
    "doctor": "tsx scripts/doctor.mts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "ehna": "npm run start -w @gonaim/ehna-api",
    "ehna:dev": "npm run dev -w @gonaim/ehna-api",
    "ehna:web": "npm run dev -w @gonaim/ehna",
    "ehna:build": "npm run build -w @gonaim/ehna",
    "ehna:setup": "tsx scripts/ehna-setup.mts",
    "ehna:backup": "tsx scripts/ehna-backup.mts",
    "ehna:restore": "tsx scripts/ehna-restore.mts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
