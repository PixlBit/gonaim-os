# GONAIM//OS + EHNA//OS — نسخة المثال.
# انسخه إلى .env أو شغّل npm run setup / npm run ehna:setup فيُنشَآن وحدهما.
# .env نفسه لا يُرفع أبدًا (راجع .gitignore).

# ── GONAIM//OS ──────────────────────────────────────
DATABASE_URL=postgres://gonaim:gonaim@localhost:5432/gonaim
OWNER_ID=00000000-0000-0000-0000-000000000001
OWNER_EMAIL=

# المدخل المحادثي وحده يحتاجه. بدونه كل شيء آخر يعمل.
ANTHROPIC_API_KEY=

# بوابة الهاتف. فارغ = مقفولة. npm run setup يولّده.
INGEST_TOKEN=

# دورة الاستنتاج بالدقائق. 0 = يدويًا فقط.
CYCLE_MINUTES=60

# ── EHNA//OS — مساحة الاثنين ────────────────────────
# سر توقيع الجلسات (32 حرفًا على الأقل). npm run ehna:setup يولّده.
EHNA_SECRET=

# منفذ الخادم، وأصل الواجهة في التطوير.
EHNA_PORT=8788
EHNA_WEB_ORIGIN=http://localhost:5174

# التخزين: فارغ = ملف في .ehna (محلي، يُنسخ بـcp).
# لـPostgres: postgres://user:pass@host:5432/db  ثم npm run migrate
EHNA_DATABASE_URL=
EHNA_DIR=.ehna

# خلف https اضبطها 1 حتى تصير كوكي الجلسة Secure.
EHNA_SECURE_COOKIE=0

# مجلد النسخ الاحتياطية — npm run ehna:backup يكتب فيه.
# خارج المستودع عمدًا: النسخة تحوي بصمات كلمات السر والصور.
EHNA_BACKUPS=.ehna-backups
# كم نسخة تبقى بعد التقليم.
EHNA_BACKUPS_KEEP=14

# الدومين — لـdocker compose وCaddy وحدهما.
EHNA_DOMAIN=

# الطبقة الاختيارية. بدونها المنصة تعمل كاملة وتعرض الوقائع بصيغتها الحتمية.
ANTHROPIC_API_KEY=
EHNA_MODEL=
